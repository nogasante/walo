{
  "functions": {
    "api/diagnose.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/twi.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/help.js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/api/(diagnose|forecast|log|help)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}