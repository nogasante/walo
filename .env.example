# Server-only names for the Vercel project walo-simply-zero.
# Set the values in the Vercel dashboard. Do not commit them.
# Leave a name unset and that feature says it is not set up; the rest of Walo still runs.
# The Supabase URL and publishable key are not environment variables.
# They live in app/data/app.json and are meant to be public. Never add a service-role key.
# Rotate every value here after the hackathon. See docs/HANDOFF.md.

# Plant Doctor (api/diagnose.js) and Get help (api/help.js). Both use api/_gemini.js.
GEMINI_API_KEY=

# Optional. Pins the Gemini model. When unset, api/_gemini.js picks a current Flash model.
# GEMINI_MODEL=

# 10-day forecast (api/forecast.js). Both names are required.
METEOMATICS_USER=
METEOMATICS_PASS=

# GhanaNLP Khaya, server only (api/twi.js): translate v2, TTS, and ASR.
# Unused during the hackathon: languages.enabled is ["en"], and /api/twi returns 404.
# On HTTP 403 or 429 the function backs off. The free quota refills about 16 Nov 2026 15:00 GMT.
KHAYA_API_KEY=
