# Server-only names for the Vercel project walo-simply-zero.
# Set the values in the Vercel dashboard. Do not commit them.
# Leave a name unset and that feature says it is not set up; the rest of Walo still runs.
# The Supabase URL and publishable key are not environment variables.
# They live in app/data/app.json and are meant to be public. Never add a service-role key.

GEMINI_API_KEY=
METEOMATICS_USER=
METEOMATICS_PASS=
KHAYA_API_KEY=

# Optional. Pins the Gemini model used by Plant Doctor and Get help.
# When unset, api/_gemini.js picks a current Flash model.
# GEMINI_MODEL=
